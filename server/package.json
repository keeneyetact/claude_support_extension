{
  "name": "claude-browser-bridge-mcp",
  "version": "1.3.0",
  "description": "MCP server that lets Claude Code control your real Chrome profiles via the Claude Browser Bridge extension",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "setup": "node setup.js setup",
    "postinstall": "node extension-path.js",
    "prepack": "node scripts/bundle-extension.js",
    "postpack": "node scripts/bundle-extension.js --clean",
    "pack-extension": "node scripts/pack-extension.js",
    "test": "node test/protocol.mjs && node test/e2e.mjs",
    "test:protocol": "node test/protocol.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "claude-browser-bridge-mcp": "index.js"
  },
  "files": [
    "index.js",
    "setup.js",
    "extension-path.js",
    "extension/"
  ],
  "keywords": ["mcp", "claude", "claude-code", "chrome", "browser", "automation"],
  "engines": {
    "node": ">=18"
  }
}
